# ---------------------------------------------------------------------------
# Copy this file to ".env" for local development and fill in real values.
# On Render, set these as Environment Variables in the dashboard instead.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# PostgreSQL connection string.
# Render gives you something like:
#   postgres://user:pass@host:5432/dbname
# The app automatically rewrites it to the asyncpg driver form.
DATABASE_URL=postgresql://user:password@localhost:5432/emailbot

# Fernet key used to encrypt SMTP passwords / API keys before storing them.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: if you lose or change this key, all saved secrets become unreadable.
CONFIG_ENC_KEY=replace_with_a_44_character_fernet_key=

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Get your ID by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=111111111,222222222
